# J2 physical connector pins per HDL2410 manual and 2025 RN29-RN37 net remap. 11/29 are power: do not bridge.
set_pin_assignment { link_data[0] } { LOCATION = P4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_data[1] } { LOCATION = N4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_data[2] } { LOCATION = N3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_data[3] } { LOCATION = M5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_data[4] } { LOCATION = M3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_data[5] } { LOCATION = M4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_data[6] } { LOCATION = L3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_data[7] } { LOCATION = J3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_req } { LOCATION = J4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_ack } { LOCATION = H4; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_run_n } { LOCATION = N1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { link_status } { LOCATION = M2; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# J2 pin 15 = GPIOB12 = M2, camera preview A -> B, 3.125 Mbaud
set_pin_assignment { link_camera } { LOCATION = M1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }


# Dual-display synchronous RPC. Five signals on J2-31..35 plus J2-30 GND.
set_pin_assignment { rpc_sclk } { LOCATION = J12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; } # J2-31
set_pin_assignment { rpc_mosi } { LOCATION = K11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; } # J2-32
set_pin_assignment { rpc_miso } { LOCATION = K14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; } # J2-33
set_pin_assignment { rpc_req } { LOCATION = L12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; } # J2-34
set_pin_assignment { rpc_ack } { LOCATION = M12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; } # J2-35
